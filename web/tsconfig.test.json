{
  "compilerOptions": {
    "tsBuildInfoFile": "./node_modules/.tmp/tsconfig.test.tsbuildinfo",
    "target": "es2023",
    "lib": ["ES2023", "DOM"],
    "module": "esnext",
    "types": ["vite/client", "vitest/globals", "node"],
    "allowArbitraryExtensions": true,
    "skipLibCheck": true,

    /* Bundler mode */
    "moduleResolution": "bundler",
    "allowImportingTsExtensions": true,
    "verbatimModuleSyntax": true,
    "moduleDetection": "force",
    "noEmit": true,
    "jsx": "react-jsx",

    /* Strictness */
    "strict": true,

    /* Linting */
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "erasableSyntaxOnly": true,
    "noFallthroughCasesInSwitch": true
  },
  // src/globals.d.ts is explicit here (not just "tests") because it's a pure ambient
  // declaration file — nothing imports it, so it's only visible to a program whose "include"
  // glob matches it directly. Without this, `tsc -b`'s test project type-checks src/version.ts
  // (pulled in transitively via test imports) but can't see __APP_VERSION__.
  "include": ["tests", "src/globals.d.ts"]
}
